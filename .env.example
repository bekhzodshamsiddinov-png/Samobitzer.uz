# Admin panel login password (set in Vercel → Project → Settings → Environment Variables)
ADMIN_PASSWORD=
# Random long string used to sign admin sessions
SESSION_SECRET=
# Added automatically when a Vercel Blob store is connected
BLOB_READ_WRITE_TOKEN=
# Where new requests are emailed
LEAD_EMAIL_TO=samo_bitzer@mail.ru
# SMTP for sending lead emails (e.g. smtp.mail.ru:465 with a mail.ru "app password")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
